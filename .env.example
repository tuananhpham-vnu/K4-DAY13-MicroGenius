APP_ENV=dev
APP_NAME=day13-observability-lab
LOG_LEVEL=INFO
LOG_PATH=data/logs.jsonl
AUDIT_LOG_PATH=data/audit.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_NAME=day13-chat
LANGFUSE_PROMPT_LABEL=production

# Real LLM provider (optional). Set GEMINI_API_KEY to switch off the mock LLM.
# LLM_PROVIDER=auto picks Gemini automatically when GEMINI_API_KEY is set;
# set to "mock" to force FakeLLM even if a Gemini key is present (useful for
# reproducible incident/chaos demos), or "gemini" to require it.
GEMINI_API_KEY=
GEMINI_PROVIDER=gemini-2.0-flash
LLM_PROVIDER=auto

# Cost guard: hard-caps output tokens per response (both FakeLLM and GeminiLLM).
# Leave unset for no cap.
COST_GUARD_MAX_OUTPUT_TOKENS=
